{
  "name": "frontend",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build && node ../scripts/prerender-static-pages.mjs && node ../scripts/inject-early-hints.mjs && node ../scripts/inline-critical-css.mjs",
    "build:e2e": "VITE_E2E_AUTH_BYPASS=true vinxi build --mode e2e && node ../scripts/prerender-static-pages.mjs && node ../scripts/inject-early-hints.mjs && node ../scripts/inline-critical-css.mjs && rm -rf dist-e2e && mv dist dist-e2e",
    "start": "vinxi start",
    "preview": "npx wrangler pages dev dist --ip 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:line": "playwright test --workers=1 --reporter=line --timeout=15000",
    "deploy": "npm run test:e2e:prod && npm run deploy:prod",
    "check:prod-bundle": "node ../scripts/assert-no-e2e-markers.mjs && node ../scripts/assert-public-pages-clean.mjs && node ../scripts/assert-static-head-metadata.mjs && node ../scripts/assert-production-runtime-config.mjs",
    "deploy:prod": "npm run build && npm run check:prod-bundle && npx wrangler pages deploy dist --project-name pdftr --branch main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.0",
    "firebase": "^12.17.1",
    "solid-js": "^1.9.13",
    "vinxi": "^0.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.12",
    "wrangler": "^4.122.0"
  }
}
