{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build && node ../scripts/prerender-static-pages.mjs",
    "build:e2e": "VITE_E2E_AUTH_BYPASS=true vinxi build --mode e2e && node ../scripts/prerender-static-pages.mjs && rm -rf dist-e2e && mv dist dist-e2e",
    "start": "vinxi start",
    "preview": "npx wrangler pages dev dist --ip 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:line": "playwright test --workers=1 --reporter=line --timeout=15000",
    "deploy": "npm run test:e2e:prod && npm run deploy:prod",
    "check:prod-bundle": "node ../scripts/assert-no-e2e-markers.mjs && node ../scripts/assert-public-pages-clean.mjs",
    "deploy:prod": "npm run build && npm run check:prod-bundle && npx wrangler pages deploy dist --project-name pdftr --branch main"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.16.1",
    "@solidjs/start": "^1.1.13",
    "firebase": "^12.15.0",
    "solid-js": "^1.9.14",
    "vinxi": "^0.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.3",
    "vite-plugin-solid": "^2.11.12",
    "wrangler": "^4.105.0"
  }
}
