{
  "name": "pdf2zh-worker",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir .tmp/worker-build",
    "deploy": "npx wrangler deploy",
    "migrate:remote": "npx wrangler d1 migrations apply pdf2zh-db --remote",
    "d1:tables": "npx wrangler d1 execute pdf2zh-db --remote --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;\"",
    "secret:turnstile": "npx wrangler secret put TURNSTILE_SECRET_KEY",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.122.0"
  }
}
